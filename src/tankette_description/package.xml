<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tankette_description</name>
  <version>0.0.1</version>
  <description>
    URDF description and launch files for the Tankette robot.
    Includes sensors: RPLiDAR and IMU.
    Configured for Gazebo simulation in ROS2 Humble.
  </description>
  
  <maintainer email="user@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>
  
  <!-- Author information (optional) -->
  <author email="user@example.com">Your Name</author>
  
  <!-- Build dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <!-- Runtime dependencies -->
  <exec_depend>urdf</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  
  <!-- Build and export declarations -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
